# Redirects for Single Page Application (SPA)
# This ensures all routes are served by index.html for client-side routing
/*    /index.html   200

# Optional: API proxy redirects (if you had a backend)
# /api/*  https://your-api-server.com/api/:splat  200

# Security headers for enhanced protection
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin